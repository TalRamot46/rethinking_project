# All data is derived from, or is, the raw Inside Airbnb exports. Those are
# hundreds of megabytes and exceed GitHub's 100 MB per-file limit, so nothing
# under data/ is committed. Put listings.csv in data/raw/ and run the pipeline;
# src/01-prepare-data.R reduces it to the small data/ratings.csv that
# everything else reads.
data/

# Fitted posteriors and the cached sigma grid -- regenerable by running the
# pipeline, and large.
.cache/

# LaTeX build artefacts
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
